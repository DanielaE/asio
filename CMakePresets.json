        },
        {
          "type": "test",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Clang Debug Workflow",
      "description": "Configure, build, and test with Clang in Debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-clang"
        },
        {
          "type": "build",
          "name": "linux-clang-debug"
        },
        {
          "type": "test",
          "name": "linux-clang-debug"
        }
      ]
    },
    {
      "name": "linux-clang-release",
      "displayName": "Clang Release Workflow",
      "description": "Configure, build, and test with Clang in Release",
      "steps": [
